---
<footer class="bg-black text-white py-16 px-4 md:px-8">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-12 items-start text-center md:text-left">
    <div class="space-y-4">
      <h2 class="text-3xl md:text-4xl font-bold">Golf Academy</h2>
    </div>
    
    <div class="space-y-6">
      <div>
        <h4 class="text-xl font-bold mb-2">Available Daily</h4>
        <p class="text-sm italic text-neutral-400">Mon, Tue, Wed 1 pm - 6 pm</p>
        <p class="text-sm italic text-neutral-400">Thu, Fri, Sat, Sun 8 am - 6 pm</p>
        <p class="text-sm font-bold mt-2">Only Available by Appointment</p>
      </div>
      
      <div>
        <a href="/contact" class="text-white underline hover:opacity-70 transition-opacity">Contact me</a>
      </div>
      
      <div>
        <p class="text-sm text-neutral-400 mb-1 uppercase tracking-widest">Location:</p>
        <p class="font-bold">
          <a href="https://www.hunterranchgolf.com/" target="_blank" class="hover:opacity-70">Hunter Ranch Golf Course</a>
        </p>
        <p class="text-sm italic text-neutral-400">4041 CA-46, Paso Robles, CA 93446</p>
      </div>
      
      <div>
        <a href="/contact" class="inline-block border border-white text-white px-8 py-4 uppercase tracking-widest text-sm font-bold hover:bg-white hover:text-black transition-all">
          Book Lessons
        </a>
      </div>
    </div>
    
    <div class="flex justify-center md:justify-end">
      <div class="w-64 h-64 rounded-full overflow-hidden border-4 border-neutral-800">
        <img src="/assets/profile.webp" alt="Steve Hahn" class="w-full h-full object-cover object-top" />
      </div>
    </div>
  </div>
</footer>
