---

---

<div id="form-container">
    <form
        id="contact-form"
        action="https://api.web3forms.com/submit"
        method="POST"
        class="space-y-6 bg-white p-8 border border-neutral-200 shadow-sm"
    >
        <input
            type="hidden"
            name="access_key"
            value="604b409c-f460-470a-816b-95310acf679c"
        />
        <input type="checkbox" name="botcheck" id="" style="display: none;" />
        <div class="space-y-1">
            <label
                for="name"
                class="block text-sm font-bold uppercase tracking-widest"
                >Name <span class="text-neutral-400 font-normal">(required)</span
                ></label
            >
            <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full border-b border-black py-2 focus:outline-none focus:border-neutral-500 transition-colors"
            />
        </div>

        <div class="space-y-1">
            <label
                for="contact"
                class="block text-sm font-bold uppercase tracking-widest"
                >Email or Phone <span class="text-neutral-400 font-normal"
                    >(required)</span
                ></label
            >
            <input
                type="text"
                id="contact"
                name="contact"
                required
                class="w-full border-b border-black py-2 focus:outline-none focus:border-neutral-500 transition-colors"
            />
        </div>

        <div class="space-y-3">
            <p class="block text-sm font-bold uppercase tracking-widest">
                Interested in <span class="text-neutral-400 font-normal"
                    >(required)</span
                >
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                <label class="flex items-center gap-3 cursor-pointer group">
                    <input
                        type="checkbox"
                        name="interest"
                        value="Adult"
                        class="w-4 h-4 border-black rounded-none"
                    />
                    <span
                        class="text-sm uppercase tracking-wider group-hover:opacity-70 transition-opacity"
                        >Adult</span
                    >
                </label>
                <label class="flex items-center gap-3 cursor-pointer group">
                    <input
                        type="checkbox"
                        name="interest"
                        value="High School & younger"
                        class="w-4 h-4 border-black rounded-none"
                    />
                    <span
                        class="text-sm uppercase tracking-wider group-hover:opacity-70 transition-opacity"
                        >High School & younger</span
                    >
                </label>
                <label class="flex items-center gap-3 cursor-pointer group">
                    <input
                        type="checkbox"
                        name="interest"
                        value="Group"
                        class="w-4 h-4 border-black rounded-none"
                    />
                    <span
                        class="text-sm uppercase tracking-wider group-hover:opacity-70 transition-opacity"
                        >Group</span
                    >
                </label>
                <label class="flex items-center gap-3 cursor-pointer group">
                    <input
                        type="checkbox"
                        name="interest"
                        value="Other"
                        class="w-4 h-4 border-black rounded-none"
                    />
                    <span
                        class="text-sm uppercase tracking-wider group-hover:opacity-70 transition-opacity"
                        >Other</span
                    >
                </label>
            </div>
        </div>

        <div class="space-y-1">
            <label
                for="message"
                class="block text-sm font-bold uppercase tracking-widest"
                >Message <span class="text-neutral-400 font-normal">(required)</span
                ></label
            >
            <textarea
                id="message"
                name="message"
                required
                rows="4"
                class="w-full border-b border-black py-2 focus:outline-none focus:border-neutral-500 transition-colors"
            ></textarea>
        </div>

        <div>
            <button
                id="submit-button"
                type="submit"
                class="bg-accent text-white px-10 py-4 uppercase tracking-widest text-sm font-bold hover:bg-opacity-90 transition-colors cursor-pointer disabled:bg-neutral-400"
            >
                Submit
            </button>
        </div>
    </form>
    <div
        id="result"
        class="hidden bg-white p-12 border border-neutral-200 shadow-sm text-center space-y-4"
    >
        <h2 class="text-2xl font-bold uppercase tracking-widest text-black">Thank You</h2>
        <p class="text-neutral-600">
            Your message has been sent successfully. We will get back to you
            shortly.
        </p>
    </div>
    <div
        id="error"
        class="hidden bg-red-50 p-4 border border-red-200 text-red-600 text-sm mt-4"
    >
        Something went wrong. Please try again or contact us directly.
    </div>
</div>

<script is:inline>
    const form = document.getElementById("contact-form");
    const result = document.getElementById("result");
    const errorMsg = document.getElementById("error");
    const submitButton = document.getElementById("submit-button");

    form.addEventListener("submit", function (e) {
        e.preventDefault();
        const formData = new FormData(form);
        
        // Handle multiple checkboxes for 'interest'
        const interests = formData.getAll('interest');
        const object = Object.fromEntries(formData);
        object.interest = interests.join(', ');
        
        const json = JSON.stringify(object);

        submitButton.disabled = true;
        submitButton.innerHTML = "Sending...";
        errorMsg.classList.add("hidden");

        fetch("https://api.web3forms.com/submit", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                Accept: "application/json",
            },
            body: json,
        })
            .then(async (response) => {
                let json = await response.json();
                if (response.status == 200) {
                    form.classList.add("hidden");
                    result.classList.remove("hidden");
                } else {
                    console.log(response);
                    errorMsg.innerText = json.message || "Something went wrong.";
                    errorMsg.classList.remove("hidden");
                }
            })
            .catch((error) => {
                console.log(error);
                errorMsg.innerText = "Something went wrong. Please try again.";
                errorMsg.classList.remove("hidden");
            })
            .then(function () {
                submitButton.disabled = false;
                submitButton.innerHTML = "Submit";
            });
    });
</script>
